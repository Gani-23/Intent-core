LSA_API_KEY=change-me-long-random-key
LSA_ENVIRONMENT_NAME=prod
LSA_ORGANIZATION_NAME=default
LSA_RUN_EMBEDDED_WORKER=0
LSA_CONTROL_PLANE_ALERTS_ENABLED=1
LSA_PIP_INSTALL_EXTRAS=postgres

POSTGRES_DB=lsa_prod
POSTGRES_USER=lsa
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

LSA_DATABASE_URL=postgresql://lsa:change-me-strong-password@postgres:5432/lsa_prod
LSA_ENABLE_POSTGRES_RUNTIME=1
LSA_POSTGRES_RUNTIME_DATABASE_URL=postgresql://lsa:change-me-strong-password@postgres:5432/lsa_prod

LSA_WORKLOAD_PROOF_TARGET_PROFILE=public-echo-pair

# Optional hardening
# LSA_AUTHZ_ENABLED=1
# LSA_REQUIRE_ACTOR_HEADERS=1
# LSA_REQUIRE_ACTOR_ORGANIZATION_HEADERS=1
